---
// src/layouts/PostLayout.astro
import BaseLayout from './BaseLayout.astro';
import { categorySlug } from '../utils/categories';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  pubDate?: string;
  updatedDate?: string;
  categories?: string[];
  schema?: any;
  'og:title'?: string;
  'og:description'?: string;
  'og:image'?: string;
  'og:url'?: string;
  'og:type'?: string;
  'twitter:card'?: string;
  'twitter:title'?: string;
  'twitter:description'?: string;
  'twitter:image'?: string;
}

const { 
  title, 
  description = '', 
  canonical = '', 
  pubDate = '', 
  updatedDate = '',
  categories = [],
  schema,
  'og:title': ogTitle,
  'og:description': ogDesc,
  'og:image': ogImage,
  'og:url': ogUrl,
  'og:type': ogType,
  'twitter:card': twitterCard,
  'twitter:title': twitterTitle,
  'twitter:description': twitterDesc,
  'twitter:image': twitterImage,
} = Astro.props;

// Get slug from URL pathname
const currentSlug = Astro.url.pathname.replace(/\//g, '').replace('.html', '');

const formattedDate = pubDate ? new Date(pubDate).toLocaleDateString('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}) : '';

const formattedUpdated = updatedDate ? new Date(updatedDate).toLocaleDateString('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}) : '';

// Extract author name from schema
const extractAuthorName = (schemaData: any): string | null => {
  if (!schemaData) return null;
  try {
    if (typeof schemaData === 'string') {
      const parsed = JSON.parse(schemaData);
      if (parsed['@graph'] && Array.isArray(parsed['@graph'])) {
        for (const item of parsed['@graph']) {
          if (item['@type'] === 'Person' && item['name'] && item['@id']?.includes('author')) {
            return item['name'];
          }
        }
      }
    } else if (schemaData['@graph'] && Array.isArray(schemaData['@graph'])) {
      for (const item of schemaData['@graph']) {
        if (item['@type'] === 'Person' && item['name'] && item['@id']?.includes('author')) {
          return item['name'];
        }
      }
    }
  } catch (e) {
    // Silent fail
  }
  return null;
};

const authorName = extractAuthorName(schema);

// Convert absolute og:image URL to local relative path for display
const getLocalImagePath = (imageUrl?: string) => {
  if (!imageUrl) return null;
  if (imageUrl.startsWith('/')) return imageUrl;
  return imageUrl.replace('https://modeme-automobiles.com', '');
};

const heroImage = getLocalImagePath(ogImage);

// Get related posts from same category
const getAllPosts = async () => {
  return await getCollection('posts');
};

const allPosts = await getAllPosts();
const primaryCategory = categories && categories.length > 0 ? categories[0] : null;

const relatedPosts = primaryCategory 
  ? allPosts
      .filter(post => 
        post.data.categories?.includes(primaryCategory) && 
        post.data.postSlug !== currentSlug
      )
      .filter(post => post.data.pubDate)
      .sort((a, b) => {
        const dateA = new Date(a.data.pubDate || '');
        const dateB = new Date(b.data.pubDate || '');
        return dateB.getTime() - dateA.getTime();
      })
      .slice(0, 3)
  : [];

// Truncate title for breadcrumb (max 50 chars with ellipsis)
const truncateTitle = (str: string, maxLen: number = 50): string => {
  if (str.length <= maxLen) return str;
  return str.substring(0, maxLen - 3) + '...';
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  
  <meta property="og:title" content={ogTitle || title} />
  <meta property="og:description" content={ogDesc || description} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  {ogUrl && <meta property="og:url" content={ogUrl} />}
  {ogType && <meta property="og:type" content={ogType} />}
  {twitterCard && <meta name="twitter:card" content={twitterCard} />}
  {twitterTitle && <meta name="twitter:title" content={twitterTitle} />}
  {twitterDesc && <meta name="twitter:description" content={twitterDesc} />}
  {twitterImage && <meta name="twitter:image" content={twitterImage} />}

  <article class="article">
    {/* Breadcrumb Navigation */}
    {primaryCategory && (
      <nav class="breadcrumb" aria-label="Fil d'ariane">
        <ol class="breadcrumb-list">
          <li class="breadcrumb-item">
            <a href="/">Accueil</a>
          </li>
          <li class="breadcrumb-separator">
            <span>></span>
          </li>
          <li class="breadcrumb-item">
            <a href={`/categories/${categorySlug(primaryCategory)}/`}>{primaryCategory}</a>
          </li>
          <li class="breadcrumb-separator">
            <span>></span>
          </li>
          <li class="breadcrumb-item active">
            <span class="current-page">{truncateTitle(title)}</span>
          </li>
        </ol>
      </nav>
    )}

    {heroImage && (
      <div class="article-hero">
        <img src={heroImage} alt={title} class="hero-image" />
        <div class="hero-overlay"></div>
        <div class="hero-text">
          <h1>{title}</h1>
        </div>
      </div>
    )}

    <div class="article-container">
      {!heroImage && (
        <div class="article-header">
          <h1>{title}</h1>
        </div>
      )}
      
      <div class="article-meta-section">
        <div class="article-meta">
          {formattedDate && <span class="publish-date">{formattedDate}</span>}
          {authorName && <span class="author">Par {authorName}</span>}
          {formattedUpdated && formattedUpdated !== formattedDate && (
            <span class="update-date">Mis à jour {formattedUpdated}</span>
          )}
        </div>

        {categories.length > 0 && (
          <div class="categories-list">
            {categories.map(cat => (
              <a href={`/categories/${categorySlug(cat)}/`} class="category-tag">
                {cat}
              </a>
            ))}
          </div>
        )}
      </div>

      <div class="article-body" data-article-body>
        <slot />
      </div>

      {/* Share Row */}
      <div class="share-section">
        <div class="share-header">Partager cet article</div>
        <div class="share-buttons">
          <a 
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(ogUrl || canonical)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn facebook"
            aria-label="Partager sur Facebook"
            title="Facebook"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a 
            href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(ogUrl || canonical)}&text=${encodeURIComponent(title)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn twitter"
            aria-label="Partager sur Twitter"
            title="Twitter / X"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
            </svg>
          </a>
          <a 
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(ogUrl || canonical)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn linkedin"
            aria-label="Partager sur LinkedIn"
            title="LinkedIn"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
            </svg>
          </a>
          <button 
            class="share-btn copy-link"
            aria-label="Copier le lien"
            title="Copier le lien"
            data-copy-url={ogUrl || canonical}
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
          </button>
        </div>
        <div class="copy-feedback" id="copyFeedback"></div>
      </div>

      {/* Related Posts Section */}
      {relatedPosts.length > 0 && (
        <div class="related-section">
          <h2 class="related-title">Articles similaires</h2>
          <div class="related-grid">
            {relatedPosts.map(post => {
              const postImage = getLocalImagePath(post.data['og:image']);
              return (
                <article class="related-card">
                  {postImage && (
                    <div class="related-image-wrapper">
                      <img src={postImage} alt={post.data.title} class="related-image" />
                      {post.data.categories && post.data.categories.length > 0 && (
                        <span class="related-tag">{post.data.categories[0]}</span>
                      )}
                    </div>
                  )}
                  <div class="related-content">
                    <h3>
                      <a href={`/${post.data.postSlug}/`}>{post.data.title}</a>
                    </h3>
                    {post.data.pubDate && (
                      <time class="related-date">
                        {new Date(post.data.pubDate).toLocaleDateString('fr-FR', {
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric'
                        })}
                      </time>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
          {primaryCategory && (
            <div class="view-all-link">
              <a href={`/categories/${categorySlug(primaryCategory)}/`}>Voir tous les articles →</a>
            </div>
          )}
        </div>
      )}
    </div>
  </article>

  <script>
    // Calculate and display reading time on page load
    function calculateReadingTime() {
      const bodyElement = document.querySelector('[data-article-body]');
      if (!bodyElement) return;
      
      const text = bodyElement.innerText || bodyElement.textContent || '';
      const wordCount = text.trim().split(/\s+/).length;
      const readingTimeMinutes = Math.ceil(wordCount / 200);
      
      // Add to meta section
      const metaSection = document.querySelector('.article-meta');
      if (metaSection) {
        const readingTimeSpan = document.createElement('span');
        readingTimeSpan.className = 'reading-time';
        readingTimeSpan.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="reading-time-icon"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>${readingTimeMinutes} min de lecture`;
        metaSection.appendChild(readingTimeSpan);
      }
    }
    
    // Copy link functionality
    document.addEventListener('DOMContentLoaded', () => {
      calculateReadingTime();
      
      const copyBtn = document.querySelector('[data-copy-url]');
      if (copyBtn) {
        copyBtn.addEventListener('click', async (e) => {
          e.preventDefault();
          const url = copyBtn.getAttribute('data-copy-url');
          try {
            await navigator.clipboard.writeText(url);
            const feedback = document.getElementById('copyFeedback');
            if (feedback) {
              feedback.textContent = 'Copié !';
              feedback.style.display = 'block';
              setTimeout(() => {
                feedback.style.display = 'none';
              }, 2000);
            }
          } catch (err) {
            console.error('Failed to copy:', err);
          }
        });
      }
    });
  </script>

  <style>
    .article {
      margin-bottom: 4rem;
    }

    /* ===== BREADCRUMB ===== */
    .breadcrumb {
      margin-bottom: 2.5rem;
      margin-top: -1rem;
      padding: 1rem 0;
    }

    .breadcrumb-list {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
      list-style: none;
    }

    .breadcrumb-item a,
    .breadcrumb-item .current-page {
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--color-text-light);
      transition: color 0.2s ease;
      letter-spacing: -0.2px;
    }

    .breadcrumb-item a:hover {
      color: var(--color-amber);
    }

    .breadcrumb-item.active .current-page {
      color: var(--color-amber);
      font-weight: 600;
    }

    .breadcrumb-separator span {
      color: var(--color-text-light);
      font-size: 0.85rem;
      display: inline-block;
      margin: 0 0.3rem;
    }

    /* ===== HERO IMAGE ===== */
    .article-hero {
      position: relative;
      width: calc(100% + 4rem);
      margin-left: -2rem;
      margin-right: -2rem;
      height: 520px;
      overflow: hidden;
      margin-bottom: 0;
      border-radius: 20px;
      background: #1c1a17;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
      margin-top: -3rem;
      margin-bottom: 3rem;
    }

    .hero-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .hero-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.4) 70%, rgba(0, 0, 0, 0.6) 100%);
      pointer-events: none;
    }

    .hero-text {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 3rem 2rem 2.5rem;
      max-width: 900px;
      margin: 0 auto;
    }

    .article-hero h1 {
      color: var(--color-cream);
      font-family: var(--font-display);
      font-size: 2.8rem;
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: -0.8px;
      margin: 0;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    }

    /* ===== CONTAINER & HEADER ===== */
    .article-container {
      max-width: 900px;
      margin: 0 auto;
      padding: 2rem 2rem 0;
    }

    .article-header {
      margin-bottom: 2.5rem;
      padding-bottom: 0;
    }

    .article-header h1 {
      font-family: var(--font-display);
      font-size: 2.8rem;
      margin-bottom: 1.5rem;
      line-height: 1.15;
      color: var(--color-text-primary);
      font-weight: 700;
      letter-spacing: -0.8px;
    }

    /* ===== META SECTION ===== */
    .article-meta-section {
      margin-bottom: 2.5rem;
      padding-bottom: 2rem;
      border-bottom: 2px solid var(--color-amber-light);
    }

    .article-meta {
      display: flex;
      gap: 2rem;
      flex-wrap: wrap;
      font-size: 0.95rem;
      color: var(--color-text-light);
      margin-bottom: 1rem;
      font-weight: 500;
      letter-spacing: -0.2px;
    }

    .publish-date,
    .author,
    .update-date,
    .reading-time,
    :global(.reading-time) {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .reading-time-icon,
    :global(.reading-time-icon) {
      width: 16px;
      height: 16px;
      color: var(--color-amber);
      flex-shrink: 0;
    }

    .categories-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .category-tag {
      display: inline-block;
      padding: 0.6rem 1.2rem;
      background: var(--color-amber);
      color: var(--color-cream);
      border: none;
      border-radius: 24px;
      font-size: 0.85rem;
      font-weight: 600;
      transition: all 0.2s ease;
      letter-spacing: -0.2px;
      text-transform: uppercase;
      font-size: 0.8rem;
    }

    .category-tag:hover {
      background: var(--color-amber-dark);
      color: var(--color-cream);
      transform: translateY(-2px);
    }

    /* ===== ARTICLE BODY ===== */
    .article-body {
      font-size: 1.1rem;
      line-height: 1.75;
      color: var(--color-text-primary);
      letter-spacing: -0.2px;
    }

    .article-body :global(h2) {
      font-family: var(--font-display);
      font-size: 2rem;
      margin-top: 2.5rem;
      margin-bottom: 1.25rem;
      color: var(--color-text-primary);
      font-weight: 700;
      border-left: 4px solid var(--color-amber);
      padding-left: 1.5rem;
      line-height: 1.2;
      letter-spacing: -0.5px;
    }

    .article-body :global(h3) {
      font-family: var(--font-display);
      font-size: 1.5rem;
      margin-top: 2rem;
      margin-bottom: 1rem;
      color: var(--color-text-primary);
      font-weight: 700;
      letter-spacing: -0.3px;
    }

    .article-body :global(h4) {
      font-family: var(--font-display);
      font-size: 1.2rem;
      margin-top: 1.75rem;
      margin-bottom: 0.75rem;
      color: var(--color-text-primary);
      font-weight: 700;
      letter-spacing: -0.2px;
    }

    .article-body :global(h5),
    .article-body :global(h6) {
      font-family: var(--font-display);
      font-size: 1.05rem;
      margin-top: 1.5rem;
      margin-bottom: 0.5rem;
      color: var(--color-text-primary);
      font-weight: 700;
      letter-spacing: -0.1px;
    }

    .article-body :global(p) {
      margin-bottom: 1.5rem;
      color: var(--color-text-primary);
    }

    .article-body :global(img) {
      width: 100% !important;
      height: auto !important;
      max-width: 100%;
      margin: 2.5rem 0;
      border-radius: 12px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
      display: block;
    }

    .article-body :global(ul, ol) {
      margin-left: 2rem;
      margin-bottom: 1.5rem;
    }

    .article-body :global(li) {
      margin-bottom: 0.75rem;
      color: var(--color-text-primary);
    }

    .article-body :global(blockquote) {
      border-left: 4px solid var(--color-amber);
      padding: 1.5rem 1.5rem 1.5rem 2rem;
      margin: 2.5rem 0;
      background: var(--color-cream-light);
      border-radius: 8px;
      color: var(--color-text-primary);
      font-style: italic;
      font-size: 1.1rem;
      letter-spacing: -0.2px;
    }

    /* Callout style available for future use */
    .article-body :global(.callout) {
      border-left: 4px solid var(--color-amber);
      padding: 1.5rem 1.5rem 1.5rem 2rem;
      margin: 2.5rem 0;
      background: rgba(232, 130, 26, 0.08);
      border-radius: 8px;
      color: var(--color-text-primary);
      font-size: 1rem;
      letter-spacing: -0.2px;
    }

    .article-body :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 2rem 0;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .article-body :global(th, td) {
      padding: 1rem;
      border: 1px solid #ddd;
      text-align: left;
    }

    .article-body :global(th) {
      background: var(--color-dark-header);
      color: var(--color-cream);
      font-weight: 600;
    }

    .article-body :global(tr:hover) {
      background: var(--color-cream-light);
    }

    .article-body :global(code) {
      background: var(--color-cream-light);
      padding: 0.3rem 0.6rem;
      border-radius: 4px;
      font-family: 'Monaco', 'Courier New', monospace;
      font-size: 0.9rem;
      color: var(--color-amber);
    }

    .article-body :global(pre) {
      background: var(--color-dark-header);
      color: #e8e8e8;
      padding: 1.5rem;
      border-radius: 8px;
      overflow-x: auto;
      margin: 2rem 0;
      font-family: 'Monaco', 'Courier New', monospace;
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .article-body :global(pre code) {
      background: none;
      padding: 0;
      color: #e8e8e8;
    }

    .article-body :global(strong) {
      font-weight: 700;
      color: var(--color-text-primary);
    }

    .article-body :global(em) {
      font-style: italic;
      color: var(--color-text-primary);
    }

    /* ===== SHARE SECTION ===== */
    .share-section {
      margin: 3.5rem 0;
      padding: 2.5rem 0;
      border-top: 2px solid var(--color-amber-light);
      border-bottom: 2px solid var(--color-amber-light);
    }

    .share-header {
      font-family: var(--font-display);
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--color-text-primary);
      margin-bottom: 1.5rem;
      letter-spacing: -0.3px;
    }

    .share-buttons {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      align-items: center;
    }

    .share-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--color-amber);
      color: white;
      transition: all 0.2s ease;
      flex-shrink: 0;
      border: none;
      cursor: pointer;
      text-decoration: none;
    }

    .share-btn svg {
      width: 22px;
      height: 22px;
    }

    .share-btn:hover {
      background: var(--color-amber-dark);
      transform: translateY(-3px);
