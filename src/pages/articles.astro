---
// src/pages/articles.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categorySlug } from '../utils/categories';

const posts = await getCollection('posts');

// Sort by date descending, newest first
const allPosts = posts
  .filter(post => post.data.pubDate) // Only posts with dates
  .sort((a, b) => {
    const dateA = new Date(a.data.pubDate || '');
    const dateB = new Date(b.data.pubDate || '');
    return dateB.getTime() - dateA.getTime();
  });

// Convert absolute og:image URL to local relative path for display
const getLocalImagePath = (imageUrl?: string) => {
  if (!imageUrl) return null;
  if (imageUrl.startsWith('/')) return imageUrl;
  return imageUrl.replace('https://modeme-automobiles.com', '');
};
---

<BaseLayout 
  title="Tous les articles - Modeme Automobiles" 
  description="Découvrez l'intégralité de nos articles et guides sur l'automobile."
>
  <div class="articles-page">
    <div class="articles-header">
      <h1>Tous nos articles</h1>
      <p>Retrouvez l'ensemble de nos guides, conseils et actualités sur l'automobile</p>
      <p class="articles-count">{allPosts.length} articles publiés</p>
    </div>

    {allPosts.length > 0 && (
      <div class="articles-grid">
        {allPosts.map(post => {
          const heroImage = getLocalImagePath(post.data['og:image']);
          return (
            <article class="article-card">
              {heroImage && (
                <div class="article-image-wrapper">
                  <img src={heroImage} alt={post.data.title} class="article-image" />
                  {post.data.categories && post.data.categories.length > 0 && (
                    <span class="article-image-tag">{post.data.categories[0]}</span>
                  )}
                </div>
              )}
              <div class="article-content">
                <h3>
                  <a href={`/${post.data.postSlug}/`}>{post.data.title}</a>
                </h3>
                {post.data.description && (
                  <p class="article-excerpt">{post.data.description.substring(0, 130)}...</p>
                )}
                <div class="article-footer">
                  <div class="article-meta">
                    {post.data.pubDate && (
                      <time>{new Date(post.data.pubDate).toLocaleDateString('fr-FR', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                      })}</time>
                    )}
                  </div>
                  <a href={`/${post.data.postSlug}/`} class="read-more">Lire →</a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </div>

  <style>
    .articles-page {
      margin-bottom: 4rem;
    }

    .articles-header {
      text-align: center;
      margin-bottom: 4rem;
    }

    .articles-header h1 {
      font-family: var(--font-display);
      font-size: 2.8rem;
      font-weight: 800;
      color: var(--color-text-primary);
      margin-bottom: 1rem;
      letter-spacing: -0.5px;
    }

    .articles-header p {
      font-size: 1.05rem;
      color: var(--color-text-secondary);
      margin-bottom: 0.5rem;
      letter-spacing: -0.2px;
    }

    .articles-count {
      font-size: 0.95rem;
      color: var(--color-text-light);
      font-weight: 500;
      margin-top: 1.5rem;
    }

    .articles-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 2.5rem;
    }

    /* Article Card */
    .article-card {
      background: var(--color-cream);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      border: 1px solid rgba(232, 130, 26, 0.1);
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .article-card:hover {
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
      transform: translateY(-4px);
      border-color: var(--color-amber);
    }

    .article-image-wrapper {
      position: relative;
      width: 100%;
      height: 240px;
      overflow: hidden;
      background: var(--color-cream-light);
    }

    .article-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.3s ease;
    }

    .article-card:hover .article-image {
      transform: scale(1.05);
    }

    .article-image-tag {
      position: absolute;
      bottom: 1rem;
      left: 1rem;
      padding: 0.5rem 1rem;
      background: var(--color-amber);
      color: white;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      z-index: 2;
    }

    .article-content {
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .article-card h3 {
      font-family: var(--font-display);
      margin: 0 0 0.75rem 0;
      font-size: 1.35rem;
      font-weight: 700;
      line-height: 1.25;
      color: var(--color-text-primary);
      flex-grow: 1;
      letter-spacing: -0.3px;
    }

    .article-card h3 a {
      color: var(--color-text-primary);
      transition: color 0.2s ease;
    }

    .article-card h3 a:hover {
      color: var(--color-amber);
    }

    .article-excerpt {
      color: var(--color-text-secondary);
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: 1.25rem;
      flex-grow: 1;
      letter-spacing: -0.2px;
    }

    .article-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 1rem;
      border-top: 1px solid rgba(232, 130, 26, 0.15);
    }

    .article-meta {
      font-size: 0.85rem;
      color: var(--color-text-light);
      font-weight: 500;
      letter-spacing: -0.2px;
    }

    .read-more {
      display: inline-block;
      font-weight: 700;
      color: var(--color-amber);
      transition: all 0.2s ease;
      font-size: 0.95rem;
      letter-spacing: -0.2px;
    }

    .read-more:hover {
      color: var(--color-amber-dark);
      transform: translateX(3px);
    }

    /* Responsive */
    @media (max-width: 1024px) {
      .articles-grid {
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 2rem;
      }
    }

    @media (max-width: 768px) {
      .articles-header h1 {
        font-size: 2rem;
      }

      .articles-grid {
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
      }

      .article-image-wrapper {
        height: 200px;
      }

      .article-content {
        padding: 1.5rem;
      }

      .article-card h3 {
        font-size: 1.2rem;
      }
    }

    @media (max-width: 480px) {
      .articles-header h1 {
        font-size: 1.5rem;
      }

      .articles-header p {
        font-size: 0.95rem;
      }

      .articles-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }

      .article-image-wrapper {
        height: 180px;
      }

      .article-content {
        padding: 1.25rem;
      }

      .article-card h3 {
        font-size: 1.1rem;
      }

      .article-excerpt {
        font-size: 0.9rem;
      }
    }
  </style>
</BaseLayout>
