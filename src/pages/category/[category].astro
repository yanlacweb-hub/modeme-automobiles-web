---
// src/pages/categories/[category].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categorySlug } from '../../utils/categories';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const categories = new Set<string>();

  posts.forEach(post => {
    if (post.data.categories) {
      post.data.categories.forEach((cat: string) => {
        categories.add(cat);
      });
    }
  });

  return Array.from(categories).map(category => ({
    params: { category: categorySlug(category) },
    props: { category },
  }));
}

interface Props {
  category: string;
}

const { category } = Astro.props;
const posts = await getCollection('posts');

const categoryPosts = posts
  .filter(post => post.data.categories && post.data.categories.some(
    (cat: string) => categorySlug(cat) === categorySlug(category)
  ))
  .filter(post => post.data.pubDate)
  .sort((a, b) => {
    const dateA = new Date(a.data.pubDate || '');
    const dateB = new Date(b.data.pubDate || '');
    return dateB.getTime() - dateA.getTime();
  });

// Find the most recent post for this category to use as hero background image
const mostRecentPost = categoryPosts[0];

// Convert absolute og:image URL to local relative path for display
const getLocalImagePath = (imageUrl?: string) => {
  if (!imageUrl) return null;
  if (imageUrl.startsWith('/')) return imageUrl;
  return imageUrl.replace('https://modeme-automobiles.com', '');
};

// Category descriptions: honest, one-line topical descriptions
const categoryDescriptions: Record<string, string> = {
  '2 roues': "Conseils et guides pratiques pour l'entretien et l'équipement de vos motos et scooters.",
  'Accessoire | équipement': "Sélection et conseils d'installation pour les meilleurs accessoires automobiles.",
  'Achat & Occasion': "Guide complet pour bien acheter votre voiture neuve ou d'occasion.",
  'conduite': "Techniques et conseils pour une conduite sûre et confortable dans toutes les conditions.",
  'covering |racing': "Solutions de personnalisation et de protection avec le covering automobile.",
  'Entretien & Mecanique': "Conseils pratiques pour l'entretien régulier et la maintenance de votre véhicule.",
  'Essence vs diesel': "Comparaison complète pour comprendre les différences et choisir le bon carburant.",
  'Général': "Articles généraux et actualités du monde de l'automobile.",
  'voiture electrique': "Guide de l'automobile électrique : technologie, autonomie et bonnes pratiques.",
};

const heroDescription = categoryDescriptions[category] || 'Articles et guides relatifs à cette catégorie.';
const heroImage = mostRecentPost ? getLocalImagePath(mostRecentPost.data['og:image']) : null;

// Category pillar text (bottom of page) — long-form intro for topical authority
const categoryBottomTexts: Record<string, string> = {
  'Achat & Occasion': `
    <h2>Bien acheter sa voiture, sans se faire avoir</h2>
    <p>Acheter une voiture, c'est souvent la deuxième plus grosse dépense d'une vie après le logement — alors autant éviter les pièges classiques. Avant de signer quoi que ce soit, il y a des vérifications qui ne devraient jamais être sautées : état mécanique réel, historique du véhicule, cohérence du kilométrage affiché avec l'usure visible. On couvre tout ça en détail dans notre <a href="/10-choses-a-verifier-lors-de-lachat-dune-voiture-doccasion/">checklist d'achat d'occasion</a>.</p>
    <p>Certains profils d'achat demandent une attention particulière : <a href="/achat-voiture-en-allemagne-un-guide-complet-pour-limportation/">importer un véhicule depuis l'Allemagne</a> implique des démarches spécifiques, et choisir une voiture pour un usage intensif comme <a href="/guide-dachat-comment-choisir-la-voiture-ideale-pour-un-chauffeur-de-taxi/">le métier de chauffeur de taxi</a> répond à des critères de fiabilité très différents d'un achat classique.</p>
    <p>Vous trouverez ici aussi des repères sur <a href="/le-top-10-des-voitures-les-plus-fiables-pour-un-premier-achat-en-2025/">les modèles qui tiennent le mieux leur valeur pour un premier achat</a>, pour éviter de vous lancer à l'aveugle sur un budget serré.</p>
  `,
  'Entretien & Mecanique': `
    <h2>L'entretien qui compte vraiment pour faire durer sa voiture</h2>
    <p>Toutes les opérations d'entretien ne se valent pas : certaines sont vitales, d'autres relèvent plus du confort. Ici, on fait le tri — à commencer par <a href="/comment-choisir-la-frequence-ideale-de-vidange-pour-votre-voiture/">la fréquence idéale de vidange</a>, qui dépend de votre moteur et de votre usage, pas d'un chiffre unique.</p>
    <p>On couvre aussi les points souvent négligés : comment <a href="/batterie-voiture-comment-survivre-a-lhiver-sans-tomber-en-panne/">survivre à l'hiver sans tomber en panne de batterie</a>, pourquoi <a href="/comment-le-nettoyage-du-systeme-dadmission-ameliore-les-performances-moteur/">le nettoyage du système d'admission</a> a un vrai impact, et comment <a href="/carnet-dentretien-un-allie-indispensable-pour-la-longevite-de-votre-voiture/">un carnet d'entretien bien tenu</a> peut faire la différence à la revente.</p>
    <p>L'idée : vous donner de quoi distinguer un entretien réellement nécessaire d'un devis gonflé par un garage qui en profite.</p>
  `,
  'Essence vs diesel': `
    <h2>Essence ou diesel : quel choix selon votre usage ?</h2>
    <p>La question n'a plus de réponse universelle depuis les restrictions de circulation diesel en ville. Ici, on compare les deux motorisations sur des critères concrets : pour qui roule beaucoup sur autoroute, le diesel garde des arguments solides ; pour un usage urbain, <a href="/les-meilleures-voitures-essence-automatiques-pour-remplacer-votre-diesel/">les modèles essence automatiques modernes</a> rattrapent une bonne partie de l'écart.</p>
    <p>On aborde aussi la question qui inquiète beaucoup de propriétaires : <a href="/lavenir-des-voitures-diesel-jusqua-quand-seront-elles-sur-nos-routes/">faut-il encore acheter un diesel</a> et que deviennent les véhicules diesel existants sur le marché de l'occasion.</p>
  `,
  'voiture electrique': `
    <h2>Voiture électrique : lever les vrais freins avant de se décider</h2>
    <p>Autonomie réelle, coût de recharge, durée de vie de la batterie : trois questions qui bloquent encore la plupart des acheteurs hésitants. Côté recharge, on couvre <a href="/guide-complet-pour-linstallation-dune-borne-de-recharge-a-domicile-pour-vehicule-electrique/">s'équiper d'une borne à domicile</a> et <a href="/borne-de-recharge-rapide-en-france-ou-recharger-a-quel-prix-et-comment-optimiser-votre-mobilite-electrique-en-2026/">trouver où recharger rapidement en déplacement</a>, avec le détail de <a href="/comprendre-le-cout-de-la-recharge-dune-voiture-electrique-a-quoi-sattendre-en-2024/">comment est calculé le coût d'une recharge</a>.</p>
    <p>Enfin, parce que le budget reste le frein numéro un, on fait le point sur les aides disponibles et sur <a href="/lentretien-dune-voiture-electrique-est-il-moins-couteux-que-celui-dun-vehicule-thermique/">une comparaison honnête des coûts d'entretien entre électrique et thermique</a>.</p>
  `,
  'conduite': `
    <h2>Conduire en sécurité, dans toutes les conditions</h2>
    <p>Cette rubrique réunit des conseils pratiques pour les moments où la conduite demande une vigilance particulière. Avant un départ, une préparation rapide du véhicule évite la grande majorité des pannes évitables : on détaille une <a href="/check-voiture-vacances-reussir-la-preparation-de-son-vehicule-pour-un-road-trip-estival-en-toute-securite/">checklist concrète avant un road-trip</a>, et comment reconnaître <a href="/fatigue-conducteur-en-ete-adopter-les-bons-reflexes-pour-des-vacances-en-toute-securite/">les signes de fatigue au volant</a> avant qu'il ne soit trop tard.</p>
    <p>On aborde aussi <a href="/moteur-fatigue-8-signes-a-surveiller-pour-eviter-la-panne-fatale/">les signaux d'un moteur fatigué</a> qui doivent alerter, et des pratiques simples pour <a href="/reduire-sa-consommation-dessence-pratiques-efficaces-pour-les-automobilistes/">réduire sa consommation d'essence</a> au quotidien.</p>
  `,
  'covering |racing': `
    <h2>Covering : transformez le look de votre voiture</h2>
    <p>Le covering, c'est la façon la plus flexible de changer complètement le style d'une voiture sans toucher à la peinture d'origine. Avant de se lancer, tout savoir sur <a href="/quest-ce-que-le-covering-voiture/">les finitions, le vrai budget à prévoir et les couleurs tendance</a> change radicalement le résultat final.</p>
    <p>Pour les plus bricoleurs, on couvre <a href="/comment-reussir-la-pose-dun-covering-voiture-soi-meme-guide-pratique-pour-passionnes/">la pose soi-même étape par étape</a>, et <a href="/bien-poser-son-covering-en-ete-guide-complet-pour-une-application-sans-defauts/">les meilleures conditions pour une pose sans défaut</a>.</p>
    <p>On parle aussi protection, pas seulement esthétique : <a href="/comment-appliquer-un-film-ppf-comme-un-pro-avec-gyeon-q²m-ppf-slip/">le film PPF protège la carrosserie des impacts et des UV</a>, une option de plus en plus choisie en complément d'un covering décoratif.</p>
  `,
  'Accessoire | équipement': `
    <h2>Les accessoires qui valent vraiment le coup</h2>
    <p>Entre les gadgets qui finissent au fond d'un tiroir et les vrais indispensables, il y a un monde. Pour le confort, on couvre <a href="/accessoire-voiture-interieur-ameliorez-votre-confort-au-quotidien/">les accessoires d'intérieur qui changent vraiment l'expérience de conduite</a>. Côté technologie, on détaille <a href="/accessoires-auto-connectes-bien-choisir-entre-chargeurs-usb-intercom-bluetooth-et-diagnostics-obd/">comment choisir entre chargeurs USB, intercoms Bluetooth et boîtiers OBD</a>.</p>
    <p>Pour la carrosserie, on a identifié <a href="/7-accessoires-indispensables-pour-proteger-sa-carrosserie-et-garder-votre-voiture-comme-neuve/">les accessoires qui offrent une vraie protection</a> contre les impacts du quotidien — pas juste un argument marketing.</p>
  `,
  '2 roues': `
    <h2>Moto et 2 roues électriques : entretien, sécurité et personnalisation</h2>
    <p>Deux-roues thermiques ou électriques, l'entretien et la sécurité n'ont rien d'accessoire. Côté sécurité : bien comprendre <a href="/comprendre-la-distance-de-securite-a-moto-pour-une-conduite-sure/">la distance de sécurité à moto</a>, choisir <a href="/comparatif-des-meilleurs-casques-modulables-et-integraux-trouver-lequilibre-entre-securite-et-confort/">un casque modulable ou intégral adapté</a>, et connaître <a href="/comprendre-les-sanctions-liees-au-non-respect-du-controle-technique-moto/">les sanctions réelles en cas de contrôle technique non respecté</a>.</p>
    <p>Les <a href="/entretien-des-deux-roues-electriques-conseils-pour-prolonger-la-duree-de-vie-de-votre-vehicule/">2 roues électriques ont leurs propres règles d'entretien</a>, différentes des motos thermiques classiques — on les détaille pour rouler en sécurité sans sacrifier l'esthétique.</p>
  `,
};

const categoryBottomText = categoryBottomTexts[category] || null;
---

<BaseLayout 
  title={`${category} - Modeme Automobiles`}
  description={`Tous les articles sur ${category}`}
>
  <div class="category-archive">
    {/* Breadcrumb Navigation */}
    <nav class="breadcrumb" aria-label="Fil d'ariane">
      <ol class="breadcrumb-list">
        <li class="breadcrumb-item">
          <a href="/">Accueil</a>
        </li>
        <li class="breadcrumb-separator">
          <span>></span>
        </li>
        <li class="breadcrumb-item">
          <a href="/">Catégories</a>
        </li>
        <li class="breadcrumb-separator">
          <span>></span>
        </li>
        <li class="breadcrumb-item active">
          <span class="current-category">{category}</span>
        </li>
      </ol>
    </nav>

    {/* Category Hero Card */}
    <div class="hero-card-wrapper">
      {heroImage && (
        <img src={heroImage} alt={category} class="hero-bg-image" />
      )}
      <div class="hero-overlay"></div>
      <div class="hero-card-content">
        <div class="hero-eyebrow">CATÉGORIE</div>
        <h1 class="hero-title">{category}</h1>
        <p class="hero-description">{heroDescription}</p>
        <div class="hero-meta">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="doc-icon"><path d="M14 2v6h6"/><path d="M4 2h10l6 6v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/></svg>
          <span>{categoryPosts.length} article{categoryPosts.length !== 1 ? 's' : ''}</span>
        </div>
      </div>
    </div>

    {/* Posts Grid */}
    {categoryPosts.length > 0 ? (
      <div class="posts-grid">
        {categoryPosts.map(post => {
          const heroImage = getLocalImagePath(post.data['og:image']);
          return (
            <article class="post-card">
              {heroImage && (
                <div class="post-image-wrapper">
                  <img src={heroImage} alt={post.data.title} class="post-image" />
                  {post.data.categories && post.data.categories.length > 0 && (
                    <span class="post-image-tag">{post.data.categories[0]}</span>
                  )}
                </div>
              )}
              <div class="post-content">
                <h2>
                  <a href={`/${post.data.postSlug}/`}>{post.data.title}</a>
                </h2>
                {post.data.description && (
                  <p class="post-excerpt">{post.data.description.substring(0, 130)}...</p>
                )}
                <div class="post-footer">
                  <div class="post-meta">
                    {post.data.pubDate && (
                      <time>{new Date(post.data.pubDate).toLocaleDateString('fr-FR', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                      })}</time>
                    )}
                  </div>
                  <a href={`/${post.data.postSlug}/`} class="read-more">Lire →</a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="no-posts">
        <p>Aucun article trouvé dans cette catégorie.</p>
        <a href="/" class="back-link">← Retour à l'accueil</a>
      </div>
    )}

    {/* Category pillar text - bottom of page */}
    {categoryBottomText && (
      <div class="category-pillar-text" set:html={categoryBottomText} />
    )}
  </div>

  <style>
    /* ===== CATEGORY PILLAR TEXT (bottom) ===== */
    .category-pillar-text {
      max-width: 800px;
      margin: 4rem auto 2rem;
      padding-top: 2.5rem;
      border-top: 1px solid var(--color-border, #e5e5e5);
    }
    .category-pillar-text h2 {
      font-size: 1.4rem;
      margin-bottom: 1rem;
    }
    .category-pillar-text p {
      line-height: 1.7;
      margin-bottom: 1rem;
      color: var(--color-text-light, #555);
    }
    .category-pillar-text a {
      text-decoration: underline;
      text-decoration-thickness: 1px;
    }

    .category-archive {
      max-width: 1200px;
      margin: 0 auto;
    }

    /* ===== BREADCRUMB ===== */
    .breadcrumb {
      margin-bottom: 2.5rem;
    }

    .breadcrumb-list {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
      list-style: none;
    }

    .breadcrumb-item a,
    .breadcrumb-item .current-category {
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--color-text-light);
      transition: color 0.2s ease;
      letter-spacing: -0.2px;
    }

    .breadcrumb-item a:hover {
      color: var(--color-amber);
    }

    .breadcrumb-item.active .current-category {
      color: var(--color-amber);
      font-weight: 600;
    }

    .breadcrumb-separator span {
      color: var(--color-text-light);
      font-size: 0.85rem;
      display: inline-block;
      margin: 0 0.3rem;
    }

    /* ===== HERO CARD ===== */
    .hero-card-wrapper {
      position: relative;
      border-radius: 20px;
      overflow: hidden;
      background: var(--color-dark-header);
      margin-bottom: 3rem;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
      min-height: 320px;
      display: flex;
      align-items: center;
    }

    .hero-bg-image {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 1;
    }

    .hero-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, rgba(42, 37, 32, 0.7) 0%, rgba(28, 26, 23, 0.85) 100%);
      z-index: 2;
    }

    .hero-card-content {
      position: relative;
      z-index: 3;
      padding: 3rem;
      max-width: 800px;
      color: var(--color-cream);
    }

    .hero-eyebrow {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: var(--color-amber);
      margin-bottom: 1rem;
      font-family: var(--font-body);
    }

    .hero-title {
      font-family: var(--font-display);
      font-size: 2.8rem;
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: 1rem;
      letter-spacing: -0.6px;
      color: var(--color-cream);
    }

    .hero-description {
      font-size: 1.05rem;
      line-height: 1.6;
      margin-bottom: 1.5rem;
      color: rgba(255, 255, 255, 0.9);
      letter-spacing: -0.2px;
    }

    .hero-meta {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.95rem;
      color: rgba(255, 255, 255, 0.85);
      font-weight: 500;
      letter-spacing: -0.2px;
    }

    .doc-icon {
      width: 18px;
      height: 18px;
      color: var(--color-amber);
      flex-shrink: 0;
    }

    /* ===== POSTS GRID ===== */
    .posts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 2.5rem;
      margin-top: 2rem;
    }

    /* Post Card with image-overlay category tag */
    .post-card {
      background: var(--color-cream);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      border: 1px solid rgba(232, 130, 26, 0.1);
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .post-card:hover {
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
      transform: translateY(-4px);
      border-color: var(--color-amber);
    }

    .post-image-wrapper {
      position: relative;
      width: 100%;
      height: 240px;
      overflow: hidden;
      background: var(--color-cream-light);
    }

    .post-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.3s ease;
    }

    .post-card:hover .post-image {
      transform: scale(1.05);
    }

    .post-image-tag {
      position: absolute;
      bottom: 1rem;
      left: 1rem;
      padding: 0.5rem 1rem;
      background: var(--color-amber);
      color: white;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      z-index: 2;
    }

    .post-content {
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .post-card h2 {
      font-family: var(--font-display);
      margin: 0 0 0.75rem 0;
      font-size: 1.35rem;
      font-weight: 700;
      line-height: 1.25;
      color: var(--color-text-primary);
      flex-grow: 1;
      letter-spacing: -0.3px;
    }

    .post-card h2 a {
      color: var(--color-text-primary);
      transition: color 0.2s ease;
    }

    .post-card h2 a:hover {
      color: var(--color-amber);
    }

    .post-excerpt {
      color: var(--color-text-secondary);
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: 1.25rem;
      flex-grow: 1;
      letter-spacing: -0.2px;
    }

    .post-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 1rem;
      border-top: 1px solid rgba(232, 130, 26, 0.15);
    }

    .post-meta {
      font-size: 0.85rem;
      color: var(--color-text-light);
      font-weight: 500;
      letter-spacing: -0.2px;
    }

    .read-more {
      display: inline-block;
      font-weight: 700;
      color: var(--color-amber);
      transition: all 0.2s ease;
      font-size: 0.95rem;
      letter-spacing: -0.2px;
    }

    .read-more:hover {
      color: var(--color-amber-dark);
      transform: translateX(3px);
    }

    /* Empty State */
    .no-posts {
      text-align: center;
      padding: 3rem 1rem;
      background: var(--color-cream-light);
      border-radius: 12px;
      margin-top: 2rem;
      border: 2px solid var(--color-amber-light);
    }

    .no-posts p {
      color: var(--color-text-secondary);
      font-size: 1.1rem;
      margin-bottom: 1.5rem;
      letter-spacing: -0.2px;
    }

    .back-link {
      display: inline-block;
      padding: 0.75rem 1.75rem;
      background: var(--color-amber);
      color: var(--color-cream);
      border-radius: 8px;
      font-weight: 700;
      transition: all 0.2s ease;
      letter-spacing: -0.2px;
    }

    .back-link:hover {
      color: var(--color-cream);
      background: var(--color-amber-dark);
      transform: translateY(-2px);
    }

    /* Responsive */
    @media (max-width: 1024px) {
      .posts-grid {
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 2rem;
      }

      .hero-title {
        font-size: 2.2rem;
      }

      .hero-card-content {
        padding: 2.5rem;
      }
    }

    @media (max-width: 768px) {
      .breadcrumb {
        margin-bottom: 2rem;
      }

      .breadcrumb-item a,
      .breadcrumb-item .current-category {
        font-size: 0.85rem;
      }

      .hero-card-wrapper {
        min-height: 280px;
      }

      .hero-card-content {
        padding: 2rem;
      }

      .hero-title {
        font-size: 1.8rem;
        margin-bottom: 0.75rem;
      }

      .hero-description {
        font-size: 0.95rem;
        margin-bottom: 1rem;
      }

      .posts-grid {
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
      }

      .post-image-wrapper {
