---
// src/pages/categories/[category].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categorySlug } from '../../utils/categories';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const categories = new Set<string>();

  posts.forEach(post => {
    if (post.data.categories) {
      post.data.categories.forEach((cat: string) => {
        categories.add(cat);
      });
    }
  });

  return Array.from(categories).map(category => ({
    params: { category: categorySlug(category) },
    props: { category },
  }));
}

interface Props {
  category: string;
}

const { category } = Astro.props;
const posts = await getCollection('posts');

const categoryPosts = posts
  .filter(post => post.data.categories && post.data.categories.some(
    (cat: string) => categorySlug(cat) === categorySlug(category)
  ))
  .filter(post => post.data.pubDate)
  .sort((a, b) => {
    const dateA = new Date(a.data.pubDate || '');
    const dateB = new Date(b.data.pubDate || '');
    return dateB.getTime() - dateA.getTime();
  });

// Find the most recent post for this category to use as hero background image
const mostRecentPost = categoryPosts[0];

// Convert absolute og:image URL to local relative path for display
const getLocalImagePath = (imageUrl?: string) => {
  if (!imageUrl) return null;
  if (imageUrl.startsWith('/')) return imageUrl;
  return imageUrl.replace('https://modeme-automobiles.com', '');
};

// Category descriptions: honest, one-line topical descriptions
const categoryDescriptions: Record<string, string> = {
  '2 roues': "Conseils et guides pratiques pour l'entretien et l'équipement de vos motos et scooters.",
  'Accessoire | équipement': "Sélection et conseils d'installation pour les meilleurs accessoires automobiles.",
  'Achat & Occasion': "Guide complet pour bien acheter votre voiture neuve ou d'occasion.",
  'conduite': "Techniques et conseils pour une conduite sûre et confortable dans toutes les conditions.",
  'covering |racing': "Solutions de personnalisation et de protection avec le covering automobile.",
  'Entretien & Mecanique': "Conseils pratiques pour l'entretien régulier et la maintenance de votre véhicule.",
  'Essence vs diesel': "Comparaison complète pour comprendre les différences et choisir le bon carburant.",
  'Général': "Articles généraux et actualités du monde de l'automobile.",
  'voiture electrique': "Guide de l'automobile électrique : technologie, autonomie et bonnes pratiques.",
};

const heroDescription = categoryDescriptions[category] || 'Articles et guides relatifs à cette catégorie.';
const heroImage = mostRecentPost ? getLocalImagePath(mostRecentPost.data['og:image']) : null;

// Category pillar text (bottom of page) — long-form intro for topical authority
const categoryBottomTexts: Record<string, string> = {
  'Achat & Occasion': `
    <h2>Bien acheter sa voiture, sans se faire avoir</h2>
    <p>Un achat de voiture réussi commence par une vérification méthodique de l'état, de l'historique et du coût réel du véhicule — c'est souvent l'une des dépenses les plus importantes d'un foyer, après le logement. Avant de signer quoi que ce soit, il y a des vérifications qui ne devraient jamais être sautées : état mécanique réel, historique du véhicule, cohérence du kilométrage affiché avec l'usure visible. On couvre tout ça en détail dans notre <a href="/10-choses-a-verifier-lors-de-lachat-dune-voiture-doccasion/">checklist d'achat d'occasion</a>.</p>
    <p>Le prix affiché ne suffit pas pour comparer deux véhicules : il faut aussi anticiper l'assurance, la consommation, l'entretien, la décote et les éventuelles réparations à court terme. Ces dépenses peuvent rendre un modèle apparemment moins cher plus coûteux sur plusieurs années.</p>
    <p>Certains profils d'achat demandent une attention particulière : <a href="/achat-voiture-en-allemagne-un-guide-complet-pour-limportation/">importer un véhicule depuis l'Allemagne</a> implique des démarches spécifiques, et choisir une voiture pour un usage intensif comme <a href="/guide-dachat-comment-choisir-la-voiture-ideale-pour-un-chauffeur-de-taxi/">le métier de chauffeur de taxi</a> répond à des critères de fiabilité très différents d'un achat classique.</p>
    <p>Vous trouverez également des repères sur <a href="/le-top-10-des-voitures-les-plus-fiables-pour-un-premier-achat-en-2025/">les voitures réputées fiables pour un premier achat</a>, afin de limiter les risques lorsque le budget est serré.</p>
  `,
  'Entretien & Mecanique': `
    <h2>L'entretien de voiture qui compte vraiment</h2>
    <p>Un entretien de voiture adapté à son kilométrage et à son usage permet de prévenir certaines pannes sans multiplier les interventions inutiles. Toutes les opérations ne se valent pas : certaines sont indispensables à la sécurité et à la longévité du véhicule, d'autres relèvent surtout du confort. Ici, on fait le tri — à commencer par <a href="/comment-choisir-la-frequence-ideale-de-vidange-pour-votre-voiture/">la fréquence idéale de vidange</a>, qui dépend de votre moteur et de votre usage, pas d'un chiffre unique.</p>
    <p>Les intervalles du constructeur restent le premier repère, mais ils doivent parfois être adaptés : trajets courts répétés, circulation urbaine ou remorquage sollicitent davantage certains organes. Les pneus, les freins et les niveaux méritent aussi un contrôle régulier, au même titre que la vidange.</p>
    <p>On couvre aussi les points souvent négligés : comment <a href="/batterie-voiture-comment-survivre-a-lhiver-sans-tomber-en-panne/">survivre à l'hiver sans tomber en panne de batterie</a>, dans quels cas <a href="/comment-le-nettoyage-du-systeme-dadmission-ameliore-les-performances-moteur/">le nettoyage du système d'admission</a> peut améliorer le fonctionnement du moteur, et comment <a href="/carnet-dentretien-un-allie-indispensable-pour-la-longevite-de-votre-voiture/">un carnet d'entretien bien tenu</a> peut faire la différence à la revente.</p>
    <p>L'objectif : vous aider à distinguer une intervention réellement justifiée d'une prestation optionnelle, et à poser les bonnes questions avant d'accepter un devis.</p>
  `,
  'Essence vs diesel': `
    <h2>Essence ou diesel : quel choix selon votre usage ?</h2>
    <p>La réponse dépend désormais autant du kilométrage et du type de trajet que des règles de circulation applicables dans votre zone. Ici, on compare les deux motorisations sur des critères concrets : pour qui roule beaucoup sur autoroute, le diesel conserve un avantage de consommation ; pour un usage urbain ou un faible kilométrage annuel, <a href="/les-meilleures-voitures-essence-automatiques-pour-remplacer-votre-diesel/">certains modèles essence automatiques</a> peuvent être plus adaptés.</p>
    <p>Le kilométrage annuel ne suffit pas à lui seul : la nature des trajets compte aussi. Un diesel utilisé presque uniquement sur de courtes distances peut ne pas atteindre régulièrement ses bonnes conditions de fonctionnement, ce qui use certains composants prématurément. Avant de choisir, il faut comparer le coût d'achat, la consommation réelle, l'entretien prévisible, l'assurance et les perspectives de revente.</p>
    <p>On aborde aussi la question qui inquiète beaucoup de propriétaires : <a href="/lavenir-des-voitures-diesel-jusqua-quand-seront-elles-sur-nos-routes/">faut-il encore acheter un diesel</a> et que deviennent les véhicules diesel existants sur le marché de l'occasion. Pensez aussi à vérifier les règles de circulation (ZFE, vignette Crit'Air) applicables dans votre commune avant de trancher, car elles varient d'une ville à l'autre.</p>
  `,
  'voiture electrique': `
    <h2>Voiture électrique : lever les vrais freins avant de se décider</h2>
    <p>Autonomie réelle, coût de recharge et durée de vie de la batterie figurent parmi les principales questions des acheteurs qui envisagent de passer à l'électrique. Côté recharge, nous expliquons comment <a href="/guide-complet-pour-linstallation-dune-borne-de-recharge-a-domicile-pour-vehicule-electrique/">installer une borne à domicile</a> et où <a href="/borne-de-recharge-rapide-en-france-ou-recharger-a-quel-prix-et-comment-optimiser-votre-mobilite-electrique-en-2026/">trouver une recharge rapide en déplacement</a>, avec le détail de <a href="/comprendre-le-cout-de-la-recharge-dune-voiture-electrique-a-quoi-sattendre-en-2024/">comment est calculé le coût d'une recharge</a>.</p>
    <p>Le bilan varie fortement selon les conditions de recharge : une recharge régulière à domicile n'entraîne généralement pas les mêmes coûts ni les mêmes contraintes qu'un recours fréquent aux bornes rapides. Il faut donc partir de ses trajets habituels et de ses possibilités de stationnement avant de comparer les modèles.</p>
    <p>Le budget restant un critère déterminant, nous faisons aussi le point sur <a href="/lentretien-dune-voiture-electrique-est-il-moins-couteux-que-celui-dun-vehicule-thermique/">une comparaison honnête des coûts d'entretien entre électrique et thermique</a> — un poste souvent sous-estimé par rapport au prix d'achat, alors qu'il pèse sur plusieurs années d'usage.</p>
  `,
  'conduite': `
    <h2>Conduire en sécurité, dans toutes les conditions</h2>
    <p>Cette rubrique réunit des conseils pratiques pour les moments où la conduite demande une vigilance particulière. Avant un long trajet, quelques contrôles simples permettent de réduire le risque de panne et de repérer une anomalie avant le départ : on détaille une <a href="/check-voiture-vacances-reussir-la-preparation-de-son-vehicule-pour-un-road-trip-estival-en-toute-securite/">checklist concrète avant un road-trip</a>, et comment reconnaître <a href="/fatigue-conducteur-en-ete-adopter-les-bons-reflexes-pour-des-vacances-en-toute-securite/">les premiers signes de fatigue au volant</a> et quand il est nécessaire de faire une pause.</p>
    <p>La pression et l'état des pneus, le niveau des liquides et le bon fonctionnement des feux méritent une vérification avant un long trajet. Sur la route, la vitesse et les distances doivent être adaptées à la circulation, à la météo et à la visibilité.</p>
    <p>La sécurité passe aussi par l'attention portée au véhicule : certains bruits, voyants ou changements de comportement peuvent signaler <a href="/moteur-fatigue-8-signes-a-surveiller-pour-eviter-la-panne-fatale/">un problème mécanique à faire contrôler</a>. On aborde aussi des pratiques simples pour <a href="/reduire-sa-consommation-dessence-pratiques-efficaces-pour-les-automobilistes/">réduire sa consommation d'essence</a> au quotidien, utiles aussi bien pour le budget que pour l'anticipation des trajets.</p>
  `,
  'covering |racing': `
    <h2>Covering voiture : transformez le look sans repeindre</h2>
    <p>Le covering voiture permet de personnaliser une carrosserie tout en conservant la peinture d'origine sous le film — une solution flexible pour changer de style sans engagement permanent. Avant de se lancer, tout savoir sur <a href="/quest-ce-que-le-covering-voiture/">les finitions, le vrai budget à prévoir et les couleurs tendance</a> change le résultat final.</p>
    <p>Pour un style inspiré de la compétition, le covering permet aussi d'ajouter bandes, numéros ou éléments graphiques sans rendre la modification définitive. Le choix du design doit néanmoins rester compatible avec la visibilité et l'usage réel du véhicule.</p>
    <p>Pour les plus bricoleurs, on couvre <a href="/poser-le-covering-voiture-soi-meme-comment-proceder/">la pose soi-même étape par étape</a>, et <a href="/bien-poser-son-covering-en-ete-guide-complet-pour-une-application-sans-defauts/">les meilleures conditions pour limiter les défauts de pose</a>. Pour obtenir un résultat propre et durable, il faut choisir le bon film, préparer soigneusement le support et respecter les conditions de pose.</p>
    <p>On parle aussi protection : contrairement au covering principalement décoratif, <a href="/comment-poser-un-film-ppf-soi-meme-guide-expert-pour-reussir-la-protection-de-votre-carrosserie/">le film PPF</a> vise surtout à limiter les marques causées par les petites projections et les frottements légers, en complément d'un covering décoratif.</p>
  `,
  'Accessoire | équipement': `
    <h2>Accessoire voiture : les équipements qui valent vraiment le coup</h2>
    <p>Un bon accessoire voiture doit apporter un gain concret en confort, en sécurité ou en praticité. Entre les gadgets qui finissent au fond d'un tiroir et les vrais indispensables, il y a un monde. Pour le confort, on couvre <a href="/accessoire-voiture-interieur-ameliorez-votre-confort-au-quotidien/">les accessoires d'intérieur susceptibles d'améliorer le confort et l'organisation à bord</a>. Côté technologie, on détaille <a href="/accessoires-auto-connectes-bien-choisir-entre-chargeurs-usb-intercom-bluetooth-et-diagnostics-obd/">comment choisir entre chargeurs USB, intercoms Bluetooth et boîtiers OBD</a>.</p>
    <p>Avant d'acheter, vérifiez la compatibilité avec votre modèle, les dimensions, l'alimentation nécessaire et les conditions d'installation. Un accessoire mal fixé ou placé dans le champ de vision peut devenir gênant, voire dangereux. L'objectif n'est pas d'accumuler les équipements, mais de choisir ceux qui répondent à un besoin réel.</p>
    <p>Pour la carrosserie, on a identifié <a href="/7-accessoires-indispensables-pour-proteger-sa-carrosserie-et-garder-votre-voiture-comme-neuve/">les équipements conçus pour limiter les petites marques, les frottements ou les salissures du quotidien</a>. Nous examinons leur utilité, leur compatibilité avec le véhicule et leurs limites, pour éviter les achats peu adaptés à votre usage.</p>
  `,
  '2 roues': `
    <h2>2 roues : passion, entretien et sécurité au quotidien</h2>
    <p>Qu'on roule tous les jours en scooter ou qu'on réserve sa moto aux sorties du week-end, un deux-roues bien entretenu est plus agréable, plus rassurant et plus fidèle à son caractère. L'univers des 2 roues réunit des motos et scooters très différents, mais tous demandent un équipement adapté et un entretien régulier.</p>
    <p>Côté sécurité : bien comprendre <a href="/comprendre-la-distance-de-securite-a-moto-pour-une-conduite-sure/">la distance de sécurité à moto</a>, et choisir <a href="/comparatif-des-meilleurs-casques-modulables-et-integraux-trouver-lequilibre-entre-securite-et-confort/">un casque modulable ou intégral adapté</a> à son usage — un bon équipement fait toute la différence sur le plaisir de conduite autant que sur la protection.</p>
    <p>Les <a href="/entretien-des-deux-roues-electriques-conseils-pour-prolonger-la-duree-de-vie-de-votre-vehicule/">2 roues électriques demandent des contrôles spécifiques liés à la batterie et à la charge</a>, tout en conservant plusieurs points d'entretien communs avec les modèles thermiques : pneus, freins, éclairage et suspensions restent à surveiller sur tous les deux-roues.</p>
    <p>On rappelle aussi les obligations liées au <a href="/comprendre-les-sanctions-liees-au-non-respect-du-controle-technique-moto/">contrôle technique moto</a> et les conséquences d'un défaut de contrôle, pour rouler en règle sans y laisser le plaisir de conduire.</p>
  `,
};

const categoryBottomText = categoryBottomTexts[category] || null;
---

<BaseLayout 
  title={`${category} - Modeme Automobiles`}
  description={heroDescription}
>
  <div class="category-archive">
    {/* Breadcrumb Navigation */}
    <nav class="breadcrumb" aria-label="Fil d'ariane">
      <ol class="breadcrumb-list">
        <li class="breadcrumb-item">
          <a href="/">Accueil</a>
        </li>
        <li class="breadcrumb-separator">
          <span>></span>
        </li>
        <li class="breadcrumb-item">
          <a href="/">Catégories</a>
        </li>
        <li class="breadcrumb-separator">
          <span>></span>
        </li>
        <li class="breadcrumb-item active">
          <span class="current-category">{category}</span>
        </li>
      </ol>
    </nav>

    {/* Category Hero Card */}
    <div class="hero-card-wrapper">
      {heroImage && (
        <img src={heroImage} alt={category} class="hero-bg-image" />
      )}
      <div class="hero-overlay"></div>
      <div class="hero-card-content">
        <div class="hero-eyebrow">CATÉGORIE</div>
        <h1 class="hero-title">{category}</h1>
        <p class="hero-description">{heroDescription}</p>
        <div class="hero-meta">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="doc-icon"><path d="M14 2v6h6"/><path d="M4 2h10l6 6v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/></svg>
          <span>{categoryPosts.length} article{categoryPosts.length !== 1 ? 's' : ''}</span>
        </div>
      </div>
    </div>

    {/* Posts Grid */}
    {categoryPosts.length > 0 ? (
      <div class="posts-grid">
        {categoryPosts.map(post => {
          const heroImage = getLocalImagePath(post.data['og:image']);
          return (
            <article class="post-card">
              {heroImage && (
                <div class="post-image-wrapper">
                  <img src={heroImage} alt={post.data.title} class="post-image" />
                  {post.data.categories && post.data.categories.length > 0 && (
                    <span class="post-image-tag">{post.data.categories[0]}</span>
                  )}
                </div>
              )}
              <div class="post-content">
                <h2>
                  <a href={`/${post.data.postSlug}/`}>{post.data.title}</a>
                </h2>
                {post.data.description && (
                  <p class="post-excerpt">{post.data.description.substring(0, 130)}...</p>
                )}
                <div class="post-footer">
                  <div class="post-meta">
                    {post.data.pubDate && (
                      <time>{new Date(post.data.pubDate).toLocaleDateString('fr-FR', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                      })}</time>
                    )}
                  </div>
                  <a href={`/${post.data.postSlug}/`} class="read-more">Lire →</a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="no-posts">
        <p>Aucun article trouvé dans cette catégorie.</p>
        <a href="/" class="back-link">← Retour à l'accueil</a>
      </div>
    )}

    {/* Category pillar text - bottom of page */}
    {categoryBottomText && (
      <div class="category-pillar-text" set:html={categoryBottomText} />
    )}
  </div>

  <style>
    /* ===== CATEGORY PILLAR TEXT (bottom) ===== */
    .category-pillar-text {
      max-width: 800px;
      margin: 4rem auto 2rem;
      padding-top: 2.5rem;
      border-top: 1px solid var(--color-border, #e5e5e5);
    }
    .category-pillar-text h2 {
      font-size: 1.4rem;
      margin-bottom: 1rem;
    }
    .category-pillar-text p {
      line-height: 1.7;
      margin-bottom: 1rem;
      color: var(--color-text-light, #555);
    }
    .category-pillar-text a {
      text-decoration: underline;
      text-decoration-thickness: 1px;
    }

    .category-archive {
      max-width: 1200px;
      margin: 0 auto;
    }

    /* ===== BREADCRUMB ===== */
    .breadcrumb {
      margin-bottom: 2.5rem;
    }

    .breadcrumb-list {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
      list-style: none;
    }

    .breadcrumb-item a,
    .breadcrumb-item .current-category {
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--color-text-light);
      transition: color 0.2s ease;
      letter-spacing: -0.2px;
    }

    .breadcrumb-item a:hover {
      color: var(--color-amber);
    }

    .breadcrumb-item.active .current-category {
      color: var(--color-amber);
      font-weight: 600;
    }

    .breadcrumb-separator span {
      color: var(--color-text-light);
      font-size: 0.85rem;
      display: inline-block;
      margin: 0 0.3rem;
    }

    /* ===== HERO CARD ===== */
    .hero-card-wrapper {
      position: relative;
      border-radius: 20px;
      overflow: hidden;
      background: var(--color-dark-header);
      margin-bottom: 3rem;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
      min-height: 320px;
      display: flex;
      align-items: center;
    }

    .hero-bg-image {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 1;
    }

    .hero-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, rgba(42, 37, 32, 0.7) 0%, rgba(28, 26, 23, 0.85) 100%);
      z-index: 2;
    }

    .hero-card-content {
      position: relative;
      z-index: 3;
      padding: 3rem;
      max-width: 800px;
      color: var(--color-cream);
    }

    .hero-eyebrow {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: var(--color-amber);
      margin-bottom: 1rem;
      font-family: var(--font-body);
    }

    .hero-title {
      font-family: var(--font-display);
      font-size: 2.8rem;
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: 1rem;
      letter-spacing: -0.6px;
      color: var(--color-cream);
    }

    .hero-description {
      font-size: 1.05rem;
      line-height: 1.6;
      margin-bottom: 1.5rem;
      color: rgba(255, 255, 255, 0.9);
      letter-spacing: -0.2px;
    }

    .hero-meta {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.95rem;
      color: rgba(255, 255, 255, 0.85);
      font-weight: 500;
      letter-spacing: -0.2px;
    }

    .doc-icon {
      width: 18px;
      height: 18px;
      color: var(--color-amber);
      flex-shrink: 0;
    }

    /* ===== POSTS GRID ===== */
    .posts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 2.5rem;
      margin-top: 2rem;
    }

    /* Post Card with image-overlay category tag */
    .post-card {
      background: var(--color-cream);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      border: 1px solid rgba(232, 130, 26, 0.1);
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .post-card:hover {
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
      transform: translateY(-4px);
      border-color: var(--color-amber);
    }

    .post-image-wrapper {
      position: relative;
      width: 100%;
      height: 240px;
      overflow: hidden;
      background: var(--color-cream-light);
    }

    .post-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.3s ease;
    }

    .post-card:hover .post-image {
      transform: scale(1.05);
    }

    .post-image-tag {
      position: absolute;
      bottom: 1rem;
      left: 1rem;
      padding: 0.5rem 1rem;
      background: var(--color-amber);
      color: white;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      z-index: 2;
    }

    .post-content {
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
